# Copy to .env.production and set actual values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# Soft theme rollout percentage (0-100)
NEXT_PUBLIC_SOFT_ROLLOUT_PERCENT=10

# Optional email providers
RESEND_API_KEY=
SENDGRID_API_KEY=

# App metadata
APP_VERSION=soft-rollout-v1

